# ==============================================================================
# AuraPredict AI - Environment Configuration Reference
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Configured on Vercel)
# ------------------------------------------------------------------------------
# VITE_API_URL: Public HTTPS URL of your Render backend.
# Leave empty for local development (will use local proxy or relative root).
# Production example: https://aurapredict-backend.onrender.com
VITE_API_URL="https://YOUR-RENDER-BACKEND.onrender.com"

# ------------------------------------------------------------------------------
# 2. BACKEND ENVIRONMENT VARIABLES (Configured on Render)
# ------------------------------------------------------------------------------
# NODE_ENV: Application runtime mode ('development' or 'production')
NODE_ENV="production"

# PORT: Server ingress port (Render automatically sets this to 10000)
PORT="10000"

# ALLOWED_ORIGINS: Comma-separated list of permitted frontend origins for CORS.
# Production example: https://aurapredict-ai.vercel.app,http://localhost:5173,http://localhost:3000
ALLOWED_ORIGINS="https://YOUR-VERCEL-FRONTEND.vercel.app,http://localhost:5173,http://localhost:3000"

# GEMINI_API_KEY: Google Gemini API key for atmospheric reasoning and generative models
GEMINI_API_KEY="AIzaSyYourGeminiApiKeyHere"

# APP_URL: Canonical URL where backend is hosted
APP_URL="https://YOUR-RENDER-BACKEND.onrender.com"

# DATA_DIR: Directory path for persistent database storage (defaults to ./data)
DATA_DIR="./data"

# SESSION_SECRET: Cryptographic secret seed for generating session tokens
SESSION_SECRET="super-secret-aurapredict-production-session-key-change-me"
